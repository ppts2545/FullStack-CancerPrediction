# MinIO (S3-compatible object store, backs Delta Lake)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional GDC token for controlled-access downloads only
# (open-access formats in this project run without token)
GDC_TOKEN=

# Optional cBioPortal API token (needed only for private/self-hosted cBioPortal instances)
CBIOPORTAL_API_TOKEN=

# EPA AQS API (register at https://aqs.epa.gov/data/api)
EPA_AQS_API_KEY=
EPA_AQS_EMAIL=

# salt for patient-id pseudonymization hashing - keep secret, store in real secrets manager in prod
PHI_SALT=change-me-in-prod
